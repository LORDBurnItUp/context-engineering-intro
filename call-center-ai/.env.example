# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LiveKit Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# TTS Providers
ELEVENLABS_API_KEY=your_elevenlabs_api_key  # Premium voice (optional)
# OpenAI TTS is used as fallback with OPENAI_API_KEY

# STT Providers
DEEPGRAM_API_KEY=your_deepgram_api_key  # Fast STT (optional)
# OpenAI Whisper is used as fallback with OPENAI_API_KEY

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/callcenter
REDIS_URL=redis://localhost:6379/0

# Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Or use Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=AI Call Center

# Application Settings
APP_NAME=AI Call Center Army
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# Security
SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Performance Tuning
MAX_CONCURRENT_CALLS=10
TOKEN_CACHE_SIZE=1000
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Self-Improvement
ENABLE_LEARNING=true
MIN_CALLS_FOR_LEARNING=10
PROMPT_VERSION=1.0.0

# Monitoring
ENABLE_ANALYTICS=true
CALL_RECORDING_ENABLED=true
CALL_RECORDING_PATH=/data/recordings

# Industry-Specific
DEFAULT_INDUSTRY=hvac  # hvac, roofing, solar
DEFAULT_ROLE=support  # support, troubleshoot, sales, cold_call

# CRM Integration
CRM_WEBHOOK_URL=  # Optional external CRM webhook
CRM_API_KEY=  # Optional external CRM API key

# Deployment
HOSTINGER_SSH_HOST=your_vps_ip
HOSTINGER_SSH_USER=root
HOSTINGER_DOMAIN=callcenter.yourdomain.com
